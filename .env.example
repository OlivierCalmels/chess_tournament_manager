# Copier vers `.env.local` ou `.env.spectateur` selon le mode (fichiers souvent ignorés par git).

# --- Mode spectateur / Pages (build `npm run build:spectateur`) ---
# VITE_PUBLIC_STATE_URL=https://<hôte>/<propriétaire>/<dépôt>/raw/<branche>/data/public/live.json
# VITE_BASE_PATH=/nom-du-repo/

# --- Optionnel : URL JSON public (déjà ci-dessus en spectateur) ---
# VITE_PUBLIC_POLL_INTERVAL_MS=15000
