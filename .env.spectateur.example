# Copier ce fichier en `.env.spectateur` (non versionné) puis adapter les URLs.
# Utilisation : npm run build:spectateur
# `npm run dev:sync` impose déjà l’URL locale (5173/dev/live-state.json) pour le 2e serveur ;
# ce fichier sert surtout au build Pages et à l’intervalle de polling optionnel.
#
# URL du JSON public (fichier brut servi par ta forge après push), ex. :
# VITE_PUBLIC_STATE_URL=https://<hôte>/<propriétaire>/<dépôt>/raw/<branche>/data/public/live.json
VITE_PUBLIC_STATE_URL=
# Sous-chemin du site Pages si le dépôt est sous un préfixe (barres obliques de chaque côté).
VITE_BASE_PATH=/nom-du-repo/
# Optionnel — millisecondes entre deux rafraîchissements (défaut 15000).
# VITE_PUBLIC_POLL_INTERVAL_MS=15000
