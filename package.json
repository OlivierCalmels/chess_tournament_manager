{
  "name": "chess_tournament_manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sync:orga": "DEV_SYNC=1 ENABLE_TOURNAMENT_GIT_SYNC=1 vite --port 5173 --strictPort",
    "dev:sync:spectateur": "DEV_SYNC=1 VITE_PUBLIC_STATE_URL=http://127.0.0.1:5173/dev/live-state.json VITE_BASE_PATH=/ vite --mode spectateur --port 5174 --strictPort",
    "dev:sync:open": "node scripts/openDevSyncExternal.mjs",
    "dev:sync": "concurrently --kill-others-on-fail -n orga,spect,pages \"npm run dev:sync:orga\" \"npm run dev:sync:spectateur\" \"npm run dev:sync:open\"",
    "build": "tsc -b && vite build",
    "build:spectateur": "tsc -b && vite build --mode spectateur",
    "tournament:push": "node scripts/tournament-push.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  }
}
